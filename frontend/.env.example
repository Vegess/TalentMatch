# Production on Vercel: leave VITE_API_URL empty — vercel.json forwards /api/* to the Render API,
# so the sign-in cookie stays first-party (works in Safari / with third-party cookies blocked).
VITE_API_URL=
# Live updates (WebSocket) connect straight to the API, e.g. wss://talentmatch-api.onrender.com
VITE_WS_URL=
